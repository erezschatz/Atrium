# Copy to .env and fill in — never commit .env
ATRIUM_SECRET=replace-with-a-long-random-string
ATRIUM_USER=admin
ATRIUM_PASS=replace-with-a-strong-password
ATRIUM_DOMAIN=atrium.local
ATRIUM_PORT=443

# TLS — set both to serve HTTPS directly from Deno.
# Omit to run as plain HTTP (e.g. behind nginx/Caddy that terminates TLS).
CERT_PATH=certs/cert.pem
KEY_PATH=certs/key.pem
